From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NONPLAYT <nonplay@bxteam.org>
Date: Sat, 23 May 2026 21:35:25 +0300
Subject: [PATCH] Regionized Chunk Ticking

This patch adds regionized chunk ticking feature, by grouping adjacent chunks into regions and processing each region on its own thread.

Original idea by Dueris, modified by NONPLAYT and heavily optimized by dan28000

diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
index 73475f21a65395ab3f888d04d4860acde8aeb09c..bee7db64464be5ce696c99981c2cbbc732576485 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
@@ -104,7 +104,7 @@ public class TickThread extends Thread {
 
     public static void ensureOnlyTickThread(final String reason) {
         boolean isTickThread = isTickThread();
-        boolean isServerLevelTickThread = isServerLevelTickThread();
+        boolean isServerLevelTickThread = isServerLevelTickThread() || Thread.currentThread() instanceof RegionTickThread; // DivineMC - Regionized Chunk Ticking - region workers tick inside a single level too
         if (!isTickThread || isServerLevelTickThread) {
             LOGGER.error("Thread " + Thread.currentThread().getName() + " failed main thread ONLY tick thread check: " + reason, new Throwable());
             if (HARD_THROW) throw new IllegalStateException(reason);
@@ -137,6 +137,12 @@ public class TickThread extends Thread {
                 sb.append("null");
             }
         }
+        // DivineMC start - Regionized Chunk Ticking
+        if (currentThread instanceof RegionTickThread regionTickThread) {
+            sb.append("; Region worker of level: ");
+            sb.append(regionTickThread.currentlyTickingServerLevel == null ? "null" : regionTickThread.currentlyTickingServerLevel.getWorld().getName());
+        }
+        // DivineMC end - Regionized Chunk Ticking
         sb.append("; Is iterating over levels? ");
         sb.append(minecraftServer.isIteratingOverLevels);
         sb.append("; Are we going to hard throw? ");
@@ -226,7 +232,13 @@ public class TickThread extends Thread {
     public static boolean isTickThreadFor(final Level world) {
         if (Thread.currentThread() instanceof ServerLevelTickThread serverLevelTickThread) {
             return serverLevelTickThread.currentlyTickingServerLevel == world;
-        } else return isTickThread();
+        }
+        // DivineMC start - Regionized Chunk Ticking - a region worker belongs to the level it is ticking, so the parallel world ticking checks hold on it
+        if (org.bxteam.divinemc.config.DivineConfig.AsyncCategory.enableParallelWorldTicking && Thread.currentThread() instanceof RegionTickThread regionTickThread) {
+            return regionTickThread.currentlyTickingServerLevel == world;
+        }
+        // DivineMC end - Regionized Chunk Ticking - a region worker belongs to the level it is ticking, so the parallel world ticking checks hold on it
+        return isTickThread();
     }
 
     public static boolean isTickThreadFor(final Entity entity) {
@@ -249,4 +261,14 @@ public class TickThread extends Thread {
         public net.minecraft.server.level.ServerLevel currentlyTickingServerLevel;
     }
     // DivineMC end - Parallel world ticking
+
+    // DivineMC start - Regionized Chunk Ticking
+    public static final class RegionTickThread extends TickThread {
+        public RegionTickThread(final ThreadGroup group, final Runnable run, final String name) {
+            super(group, run, name);
+        }
+
+        public net.minecraft.server.level.ServerLevel currentlyTickingServerLevel;
+    }
+    // DivineMC end - Regionized Chunk Ticking
 }
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
index e436466877dac6495b931d306a297e41a8bc8fca..9095519b73006e1fd526dbf262808f202da83a40 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
@@ -756,21 +756,22 @@ public class CraftWorld extends CraftRegionAccessor implements World {
     @Override
     public boolean generateTree(Location loc, TreeType type, BlockChangeDelegate delegate) {
         if (org.bxteam.divinemc.config.DivineConfig.AsyncCategory.enableParallelWorldTicking) ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this.world, loc.getX(), loc.getZ(), "Cannot generate tree asynchronously"); // DivineMC - Parallel world ticking
-        this.world.captureTreeGeneration = true;
-        this.world.captureBlockStates = true;
-        List<org.bukkit.craftbukkit.block.CraftBlockState> capturedBlockStates;
+        // DivineMC start - Regionized Chunk Ticking - thread-safe block capture
+        this.world.captureTreeGeneration.set(true);
+        this.world.captureBlockStates.set(true);
+        java.util.Map<BlockPos, CraftBlockState> capturedBlockStates;
         boolean grownTree;
         try {
             grownTree = this.generateTree(loc, type);
         } finally {
-            this.world.captureTreeGeneration = false;
-            this.world.captureBlockStates = false;
+            this.world.captureBlockStates.set(false);
+            this.world.captureTreeGeneration.set(false);
 
-            capturedBlockStates = new ArrayList<>(this.world.capturedBlockStates.values());
-            this.world.capturedBlockStates.clear();
+            capturedBlockStates = this.world.capturedBlockStates.get();
+            capturedBlockStates.clear();
         }
         if (grownTree) { // Copy block data to delegate
-            for (CraftBlockState snapshot : capturedBlockStates) {
+            for (CraftBlockState snapshot : capturedBlockStates.values()) {
                 BlockPos position = snapshot.getPosition();
                 net.minecraft.world.level.block.state.BlockState oldBlock = this.world.getBlockState(position);
                 int flags = snapshot.getFlags();
@@ -780,6 +781,7 @@ public class CraftWorld extends CraftRegionAccessor implements World {
             }
         }
         return grownTree;
+        // DivineMC end - Regionized Chunk Ticking - thread-safe block capture
     }
 
     @Override
diff --git a/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java b/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java
index 05f2aaacc0d776071c9e6012495cc7311036b05c..2a920076aea5106d8a9e35f99c12d8df6a885e49 100644
--- a/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java
+++ b/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java
@@ -570,17 +570,18 @@ public class CraftBlock implements Block {
         UseOnContext context = new UseOnContext(world, null, InteractionHand.MAIN_HAND, Items.BONE_MEAL.getDefaultInstance(), new BlockHitResult(Vec3.ZERO, direction, this.getPosition(), false));
 
         // SPIGOT-6895: Call StructureGrowEvent and BlockFertilizeEvent
-        List<org.bukkit.craftbukkit.block.CraftBlockState> capturedBlockStates;
-        world.captureTreeGeneration = true;
+        // DivineMC start - Regionized Chunk Ticking - thread-safe block capture
+        java.util.Map<net.minecraft.core.BlockPos, CraftBlockState> capturedBlockStates;
+        world.captureTreeGeneration.set(true);
         TreeType treeType;
         InteractionResult result;
         try {
             result = BoneMealItem.applyBonemeal(context);
         } finally {
-            world.captureTreeGeneration = false;
+            world.captureTreeGeneration.set(false);
 
-            capturedBlockStates = new ArrayList<>(world.capturedBlockStates.values());
-            world.capturedBlockStates.clear();
+            capturedBlockStates = world.capturedBlockStates.get();
+            capturedBlockStates.clear();
 
             // DivineMC start - Parallel world ticking
             treeType = SaplingBlock.getTreeTypeTL();
@@ -601,12 +602,13 @@ public class CraftBlock implements Block {
             Bukkit.getPluginManager().callEvent(event);
 
             if (!event.isCancelled()) {
-                for (CraftBlockState snapshot : capturedBlockStates) {
+                for (CraftBlockState snapshot : capturedBlockStates.values()) {
                     snapshot.place(snapshot.getFlags());
                     world.checkCapturedTreeStateForObserverNotify(this.position, snapshot);
                 }
             }
         }
+        // DivineMC end - Regionized Chunk Ticking - thread-safe block capture
 
         return result instanceof InteractionResult.Success && (event == null || !event.isCancelled());
     }
