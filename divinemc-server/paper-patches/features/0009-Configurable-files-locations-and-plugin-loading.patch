From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dan28000 <pirkldan28@gmail.com>
Date: Thu, 12 Jun 2025 10:08:25 +0200
Subject: [PATCH] Configurable files locations and plugin loading


diff --git a/src/main/java/com/destroystokyo/paper/console/PaperConsole.java b/src/main/java/com/destroystokyo/paper/console/PaperConsole.java
index f2ffd08c716af60434d073916e2c658d71b000fc..66d65359ea00863e9ada5922b73c3cd97533c6e6 100644
--- a/src/main/java/com/destroystokyo/paper/console/PaperConsole.java
+++ b/src/main/java/com/destroystokyo/paper/console/PaperConsole.java
@@ -28,7 +28,7 @@ public final class PaperConsole extends SimpleTerminalConsole {
     protected LineReader buildReader(LineReaderBuilder builder) {
         builder
                 .appName("DivineMC") // DivineMC - Rebrand
-                .variable(LineReader.HISTORY_FILE, PaperCacheDir.moveFromServerRootAndGet(".console_history", "console_history"))
+                .variable(LineReader.HISTORY_FILE, historyFile(this.server)) // DivineMC - Configurable files locations and plugin loading
                 .completer(new ConsoleCommandCompleter(this.server))
                 .option(LineReader.Option.COMPLETE_IN_WORD, true);
         if (io.papermc.paper.configuration.GlobalConfiguration.get().console.enableBrigadierHighlighting) {
@@ -42,6 +42,15 @@ public final class PaperConsole extends SimpleTerminalConsole {
         return super.buildReader(builder);
     }
 
+    // DivineMC start - Configurable files locations and plugin loading
+    private static java.nio.file.Path historyFile(DedicatedServer server) {
+        if (server.options.has("console-history")) { // only when explicitly passed, otherwise keep the upstream location and migration
+            return ((java.io.File) server.options.valueOf("console-history")).toPath();
+        }
+        return PaperCacheDir.moveFromServerRootAndGet(".console_history", "console_history");
+    }
+    // DivineMC end - Configurable files locations and plugin loading
+
     @Override
     protected boolean isRunning() {
         return !this.server.isStopped() && this.server.isRunning();
diff --git a/src/main/java/io/papermc/paper/plugin/PluginInitializerManager.java b/src/main/java/io/papermc/paper/plugin/PluginInitializerManager.java
index 5741a60faba70da485053599c9370f0e27e868f4..602cdf655bf8706cda16385a006fa56d3cb13a74 100644
--- a/src/main/java/io/papermc/paper/plugin/PluginInitializerManager.java
+++ b/src/main/java/io/papermc/paper/plugin/PluginInitializerManager.java
@@ -108,9 +108,19 @@ public class PluginInitializerManager {
         java.util.List<Path> files = ((java.util.List<File>) optionSet.valuesOf("add-plugin")).stream().map(File::toPath).toList();
         io.papermc.paper.plugin.util.EntrypointUtil.registerProvidersFromSource(io.papermc.paper.plugin.provider.source.PluginFlagProviderSource.INSTANCE, files);
 
+        // DivineMC start - Configurable files locations and plugin loading
         @SuppressWarnings("unchecked")
-        java.util.List<Path> dirs = ((java.util.List<File>) optionSet.valuesOf("add-plugin-dir")).stream().map(File::toPath).toList();
-        dirs.forEach(pluginDir -> io.papermc.paper.plugin.util.EntrypointUtil.registerProvidersFromSource(io.papermc.paper.plugin.provider.source.DirectoryProviderSource.INSTANCE_NO_CREATE, pluginDir));
+        java.util.List<Path> pluginList = ((java.util.List<File>) optionSet.valuesOf("add-plugin-dir")).stream()
+            .filter(java.util.Objects::nonNull)
+            .map(f -> f.listFiles(file -> file.getName().endsWith(".jar")))
+            .filter(java.util.Objects::nonNull)
+            .flatMap(java.util.Arrays::stream)
+            .filter(File::isFile)
+            .map(File::toPath)
+            .toList();
+
+        io.papermc.paper.plugin.util.EntrypointUtil.registerProvidersFromSource(io.papermc.paper.plugin.provider.source.PluginFlagProviderSource.INSTANCE, pluginList);
+        // DivineMC end - Configurable files locations and plugin loading
 
         final Set<String> paperPluginNames = new TreeSet<>();
         final Set<String> legacyPluginNames = new TreeSet<>();
diff --git a/src/main/java/org/bukkit/craftbukkit/Main.java b/src/main/java/org/bukkit/craftbukkit/Main.java
index 97fc092aaf0e78e52945bd882f36d42d35be962f..832f168dcf9768c0bc26a95570c4498937ff900a 100644
--- a/src/main/java/org/bukkit/craftbukkit/Main.java
+++ b/src/main/java/org/bukkit/craftbukkit/Main.java
@@ -138,12 +138,6 @@ public class Main {
                         .defaultsTo(new File[] {})
                         .describedAs("Jar file");
 
-                this.acceptsAll(asList("add-plugin-dir", "add-extra-plugin-dir"), "Specify paths to extra plugin directories to be loaded in addition to the plugins folder. This argument can be specified multiple times, once for each extra plugin dir path.")
-                        .withRequiredArg()
-                        .ofType(File.class)
-                        .defaultsTo(new File[] {})
-                        .describedAs("Plugin directory");
-
                 // Purpur start - Purpur config files
                 this.acceptsAll(asList("purpur", "purpur-settings"), "File for purpur settings")
                     .withRequiredArg()
@@ -160,6 +154,52 @@ public class Main {
                     .describedAs("Yml file");
                 // DivineMC end - Configuration
 
+                // DivineMC start - Configurable files locations and plugin loading
+                this.acceptsAll(asList("add-plugin-dir", "add-extra-plugin-dir"), "Specify paths to directories containing extra plugin jars to be loaded in addition to those in the plugins folder. This argument can be specified multiple times, once for each extra plugin directory path.")
+                    .withRequiredArg()
+                    .ofType(File.class)
+                    .defaultsTo(new File("extra"))
+                    .describedAs("Directory");
+                // DivineMC end - Configurable files locations and plugin loading
+
+                // DivineMC start - Configurable files locations and plugin loading
+                accepts("help-location", "Location of the help file")
+                    .withRequiredArg()
+                    .ofType(File.class)
+                    .defaultsTo(new File("help.yml"))
+                    .describedAs("Help file location");
+
+                accepts("banned-players", "Location of banned players file")
+                    .withRequiredArg()
+                    .ofType(File.class)
+                    .defaultsTo(new File("banned-players.json"))
+                    .describedAs("Banned players file");
+
+                accepts("banned-ips", "Location of banned IPs file")
+                    .withRequiredArg()
+                    .ofType(File.class)
+                    .defaultsTo(new File("banned-ips.json"))
+                    .describedAs("Banned IPs file");
+
+                accepts("whitelist", "Location of whitelist file")
+                    .withRequiredArg()
+                    .ofType(File.class)
+                    .defaultsTo(new File("whitelist.json"))
+                    .describedAs("Whitelist file");
+
+                accepts("ops", "Location of operators file")
+                    .withRequiredArg()
+                    .ofType(File.class)
+                    .defaultsTo(new File("ops.json"))
+                    .describedAs("Operators file");
+
+                accepts("console-history", "Location of console history file")
+                    .withRequiredArg()
+                    .ofType(File.class)
+                    .defaultsTo(new File(".paper/console_history"))
+                    .describedAs("Console history file");
+                // DivineMC end - Configurable files locations and plugin loading
+
                 this.accepts("server-name", "Name of the server")
                         .withRequiredArg()
                         .ofType(String.class)
diff --git a/src/main/java/org/bukkit/craftbukkit/help/HelpYamlReader.java b/src/main/java/org/bukkit/craftbukkit/help/HelpYamlReader.java
index 63fee4f7fb347e608c18901f8d92b0d8c8bdd2b0..04014998397621ca48c4e2f109b63227dd2dd10f 100644
--- a/src/main/java/org/bukkit/craftbukkit/help/HelpYamlReader.java
+++ b/src/main/java/org/bukkit/craftbukkit/help/HelpYamlReader.java
@@ -23,7 +23,7 @@ public class HelpYamlReader {
     public HelpYamlReader(Server server) {
         this.server = server;
 
-        File helpYamlFile = new File("help.yml");
+        File helpYamlFile = (File) net.minecraft.server.dedicated.DedicatedServer.getServer().options.valueOf("help-location"); // DivineMC - Configurable files locations and plugin loading
         YamlConfiguration defaultConfig = YamlConfiguration.loadConfiguration(new InputStreamReader(this.getClass().getClassLoader().getResourceAsStream("configurations/help.yml"), StandardCharsets.UTF_8));
         this.helpYaml = defaultConfig;
 
