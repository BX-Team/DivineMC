     }
 
+    // DivineMC start - Parallel sensor phase
+    public final boolean divinemc$isDue() {
+        return this.timeToTick <= 1L;
+    }
+
+    public final void divinemc$tickAsync(final ServerLevel level, final E body) {
+        this.timeToTick = java.util.Objects.requireNonNullElse(level.paperConfig().tickRates.sensor.get(body.getType(), this.configKey), this.scanRate);
+        this.updateTargetingConditionRanges(body);
+        this.doTick(level, body);
+    }
+    // DivineMC end - Parallel sensor phase
+
     private void updateTargetingConditionRanges(final E body) {
         double followRange = body.getAttributeValue(Attributes.FOLLOW_RANGE);
