From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NONPLAYT <nonplay@bxteam.org>
Date: Sat, 4 Jul 2026 00:28:19 +0300
Subject: [PATCH] Parallel sensor phase

Runs due AI sensors (read-only world scans) on a worker pool before the entity
ticking phase, one task per mob, while the tick thread blocks on a join barrier
so the world can't mutate. Sensors unsafe off-thread opt out via
divinemc$canRunAsync, and TargetingConditions are made thread-local.

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 91592bb126b2f7604ca39e061f1d8cd17735257e..06e6e95621157d7264db1171201830c2f6ef9710 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -961,6 +961,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
                 this.spigotConfig.currentPrimedTnt = 0; // Spigot
             } else {
                 io.papermc.paper.entity.activation.ActivationRange.activateEntities(this); // Paper - EAR
+                org.bxteam.divinemc.async.sensing.ParallelSensorTicker.preTickSensors(this); // DivineMC - Parallel sensor phase
                 this.entityTickList
                     .forEach(
                         entity -> {
