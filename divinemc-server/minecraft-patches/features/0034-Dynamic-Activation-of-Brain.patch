diff --git a/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java b/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java
index bb037ea27688a06bb0d8141ef25d2543d34aba80..68dd90b36148ece6973ad222566e1f254264f723 100644
--- a/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java
+++ b/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java
@@ -20,6 +20,7 @@ public class VillagerPanicTrigger extends Behavior<Villager> {
 
     @Override
     protected void start(final ServerLevel level, final Villager body, final long timestamp) {
+        body.lastGolemPanicTick = timestamp - 1; // DivineMC - Dynamic Activation of Brain
         if (isHurt(body) || hasHostile(body)) {
             Brain<?> brain = body.getBrain();
             if (!brain.isActive(Activity.PANIC)) {
@@ -36,9 +37,14 @@ public class VillagerPanicTrigger extends Behavior<Villager> {
 
     @Override
     protected void tick(final ServerLevel level, final Villager body, final long timestamp) {
-        if (timestamp % 100L == 0L) {
+        // DivineMC start - Dynamic Activation of Brain
+        final long lastTick = body.lastGolemPanicTick;
+        body.lastGolemPanicTick = timestamp;
+        // a throttled brain can skip the multiple of 100, so fire on crossing it instead
+        if (body.dabTickRate() == 1 ? timestamp % 100L == 0L : timestamp / 100L != lastTick / 100L) {
             body.spawnGolemIfNeeded(level, timestamp, 3);
         }
+        // DivineMC end - Dynamic Activation of Brain
     }
 
     public static boolean hasHostile(final LivingEntity myBody) {
