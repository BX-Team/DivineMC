From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NONPLAYT <nonplay@bxteam.org>
Date: Sun, 19 Jul 2026 00:34:38 +0300
Subject: [PATCH] Raytrace Entity Culling

Server-side port of tr7zw's EntityCulling mod.
Entities that a player provably cannot see (fully hidden behind opaque blocks)
are removed from that player's entity tracker. This reduces network bandwidth,
improves client FPS and blinds entity-ESP cheats (e.g. freecam/x-ray style hacks
cannot see mobs, players or items through walls anymore).

diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index 08fad31bc0b3f79e5700eccb7baa43e75774fa87..bcac2b10e0efcdec60bc56648abc1e8fc8d9289d 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1489,6 +1489,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 && this.entity.broadcastToPlayer(player)
                 && ChunkMap.this.isChunkTracked(player, this.entity.chunkPosition().x(), this.entity.chunkPosition().z());
             // Paper end - Configurable entity tracking range by Y
+            visibleToPlayer = visibleToPlayer && !org.bxteam.divinemc.culling.EntityCullingManager.isCulled(player, this.entity); // DivineMC - Raytrace Entity Culling
             // CraftBukkit start - respect vanish API
             if (visibleToPlayer && !player.getBukkitEntity().canSeeChunkMapUpdatePlayer(this.entity.getBukkitEntity())) { // Paper - only consider hits // DivineMC - SparklyPaper: Optimize "canSee" checks
                 visibleToPlayer = false;
