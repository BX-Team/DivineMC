From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NONPLAYT <nonplay@bxteam.org>
Date: Thu, 19 Nov 2026 18:38:24 +0300
Subject: [PATCH] lithium: baby_specific_sensors


diff --git a/net/minecraft/world/entity/ai/sensing/AdultSensor.java b/net/minecraft/world/entity/ai/sensing/AdultSensor.java
index f5ada20bea9806fa9e5edabbe31fc189f1a8b918..fb1de34c92db42b67040a25de0f43046273bfedd 100644
--- a/net/minecraft/world/entity/ai/sensing/AdultSensor.java
+++ b/net/minecraft/world/entity/ai/sensing/AdultSensor.java
@@ -16,6 +16,12 @@ public class AdultSensor extends Sensor<LivingEntity> {
 
     @Override
     protected void doTick(final ServerLevel level, final LivingEntity body) {
+        // DivineMC start - lithium: baby_specific_sensors - only BabyFollowAdult reads this memory and it does nothing for adults
+        if (!body.isBaby()) {
+            body.getBrain().eraseMemory(MemoryModuleType.NEAREST_VISIBLE_ADULT);
+            return;
+        }
+        // DivineMC end - lithium: baby_specific_sensors
         body.getBrain()
             .getMemory(MemoryModuleType.NEAREST_VISIBLE_LIVING_ENTITIES)
             .ifPresent(livingEntities -> this.setNearestVisibleAdult(body, livingEntities));
diff --git a/net/minecraft/world/entity/ai/sensing/VillagerBabiesSensor.java b/net/minecraft/world/entity/ai/sensing/VillagerBabiesSensor.java
index 2f3e93d4ccf238d0656e69b789ddb811263df470..abf4b926348f6d478675cc345bef58438907a7d1 100644
--- a/net/minecraft/world/entity/ai/sensing/VillagerBabiesSensor.java
+++ b/net/minecraft/world/entity/ai/sensing/VillagerBabiesSensor.java
@@ -18,6 +18,12 @@ public class VillagerBabiesSensor extends Sensor<LivingEntity> {
 
     @Override
     protected void doTick(final ServerLevel level, final LivingEntity body) {
+        // DivineMC start - lithium: baby_specific_sensors - only the baby play activity reads this memory
+        if (!body.isBaby()) {
+            body.getBrain().eraseMemory(MemoryModuleType.VISIBLE_VILLAGER_BABIES);
+            return;
+        }
+        // DivineMC end - lithium: baby_specific_sensors
         body.getBrain().setMemory(MemoryModuleType.VISIBLE_VILLAGER_BABIES, this.getNearestVillagerBabies(body));
     }
 
