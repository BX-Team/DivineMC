+++ b/net/minecraft/network/protocol/game/ClientboundLevelChunkWithLightPacket.java
@@ -70,6 +70,28 @@ public record ClientboundLevelChunkWithLightPacket(int x, int z, ClientboundLeve
         // Paper end - Anti-Xray - Modify blocks
     }
 
+    // DivineMC start - Async Chunk Sending
+    public ClientboundLevelChunkWithLightPacket(final LevelChunk chunk, final LevelLightEngine lightEngine) {
+        ChunkPos chunkPos = chunk.getPos();
+        net.minecraft.world.level.chunk.LevelChunkSection[] sections = chunk.getSections();
+        net.minecraft.world.level.chunk.LevelChunkSection[] sectionSnapshot = new net.minecraft.world.level.chunk.LevelChunkSection[sections.length];
+        for (int i = 0; i < sections.length; ++i) {
+            sectionSnapshot[i] = sections[i].copy();
+        }
+        this(
+            chunkPos.x(),
+            chunkPos.z(),
+            new ClientboundLevelChunkPacketData(chunk, sectionSnapshot),
+            new ClientboundLightUpdatePacketData(chunkPos, lightEngine, null, null)
+        );
+    }
+
+    public void finishAsyncSerialization() {
+        this.chunkData.serializeFromSnapshot();
+        this.setReady(true);
+    }
+    // DivineMC end - Async Chunk Sending
+
     @Override
     public PacketType<ClientboundLevelChunkWithLightPacket> type() {
         return GamePacketTypes.CLIENTBOUND_LEVEL_CHUNK_WITH_LIGHT;
diff --git a/net/minecraft/server/network/PlayerChunkSender.java b/net/minecraft/server/network/PlayerChunkSender.java
index 196c01fe5f200ed57e6f23e0939cac616305571a..e2978937ee55488e97363b1711510af97ab0ecc9 100644
--- a/net/minecraft/server/network/PlayerChunkSender.java
