+    public Holder<Biome> getBiome(final int blockX, final int blockY, final int blockZ) { // DivineMC - Carpet-Fixes: Optimized getBiome method - rename params
+        // DivineMC start - Carpet-Fixes: Optimized getBiome method
+        int xMinus2 = blockX - 2;
+        int yMinus2 = blockY - 2;
+        int zMinus2 = blockZ - 2;
+        int x = xMinus2 >> 2;
+        int y = yMinus2 >> 2;
+        int z = zMinus2 >> 2;
+        double quartX = (double) (xMinus2 & 3) / 4.0;
+        double quartY = (double) (yMinus2 & 3) / 4.0;
+        double quartZ = (double) (zMinus2 & 3) / 4.0;
+        int smallestX = 0;
+        double smallestDist = Double.POSITIVE_INFINITY;
+
+        for (int biomeX = 0; biomeX < 8; ++biomeX) {
+            boolean everyOtherQuad = (biomeX & 4) == 0;
+            boolean everyOtherPair = (biomeX & 2) == 0;
+            boolean everyOther = (biomeX & 1) == 0;
+            double quartXX = everyOtherQuad ? quartX : quartX - 1.0;
+            double quartYY = everyOtherPair ? quartY : quartY - 1.0;
+            double quartZZ = everyOther ? quartZ : quartZ - 1.0;
+
+            // Lower bound of each axis' contribution: the fiddle offset lies in [-0.45, 0.45), so a corner
+            // can only win if |quart| - 0.45 still leaves it closer than the current best (vanilla uses strict >).
+            double minQuartYY = Mth.square(Math.max(0.0, Math.abs(quartYY) - maxOffset));
+            double minQuartZZ = Mth.square(Math.max(0.0, Math.abs(quartZZ) - maxOffset));
+            if (biomeX != 0 && smallestDist < Mth.square(Math.max(0.0, Math.abs(quartXX) - maxOffset)) + minQuartYY + minQuartZZ - PRUNE_EPSILON) continue;
+
+            int xx = everyOtherQuad ? x : x + 1;
+            int yy = everyOtherPair ? y : y + 1;
+            int zz = everyOther ? z : z + 1;
+
+            long seed = LinearCongruentialGenerator.next(this.biomeZoomSeed, xx);
+            seed = LinearCongruentialGenerator.next(seed, yy);
+            seed = LinearCongruentialGenerator.next(seed, zz);
+            seed = LinearCongruentialGenerator.next(seed, xx);
+            seed = LinearCongruentialGenerator.next(seed, yy);
+            seed = LinearCongruentialGenerator.next(seed, zz);
+            double offsetX = getFiddle(seed);
+            double sqrX = Mth.square(quartXX + offsetX);
+            if (biomeX != 0 && smallestDist < sqrX + minQuartYY + minQuartZZ - PRUNE_EPSILON) continue;
+            seed = LinearCongruentialGenerator.next(seed, this.biomeZoomSeed);
+            double offsetY = getFiddle(seed);
+            seed = LinearCongruentialGenerator.next(seed, this.biomeZoomSeed);
+            double offsetZ = getFiddle(seed);
+            double biomeDist = Mth.square(quartZZ + offsetZ) + Mth.square(quartYY + offsetY) + sqrX; // same summation order as vanilla
+
+            if (smallestDist > biomeDist) {
+                smallestX = biomeX;
+                smallestDist = biomeDist;
             }
         }
 
-        int biomeX = (minI & 4) == 0 ? parentX : parentX + 1;
