+        // DivineMC start - Parallel entity tracker
+        public final org.bxteam.divinemc.async.tracking.ParallelEntityTracker.@Nullable ScanResult scanPlayers(final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.TrackedChunk chunk) {
+            final ca.spottedleaf.moonrise.common.list.ReferenceList<ServerPlayer> players =
+                chunk == null ? null : chunk.getPlayers(ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.VIEW_DISTANCE);
+            if (players == null) {
+                return this.seenBy.isEmpty() && this.lastTrackedChunk == null
+                    ? null
+                    : new org.bxteam.divinemc.async.tracking.ParallelEntityTracker.ScanResult(this, null, null, true);
+            }
+
+            final long lastChunkUpdate = this.lastChunkUpdate;
+            final long currChunkUpdate = chunk.getUpdateCount();
+            final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.TrackedChunk lastTrackedChunk = this.lastTrackedChunk;
+            this.lastChunkUpdate = currChunkUpdate;
+            this.lastTrackedChunk = chunk;
+
+            java.util.List<ServerPlayer> toAdd = null;
+            java.util.List<ServerPlayer> toRemove = null;
+
+            final ServerPlayer[] playersRaw = players.getRawDataUnchecked();
+            final int playersLength = Math.min(playersRaw.length, players.size());
+            for (int i = 0; i < playersLength; ++i) {
+                final ServerPlayer player = playersRaw[i];
+                if (player == null || player == this.entity) continue;
+                final boolean wantsToSee = this.wantsToSee(player);
+                if (wantsToSee == this.seenBy.contains(player.connection)) continue;
+                if (wantsToSee) {
+                    if (toAdd == null) toAdd = new java.util.ArrayList<>(4);
+                    toAdd.add(player);
+                } else {
+                    if (toRemove == null) toRemove = new java.util.ArrayList<>(4);
+                    toRemove.add(player);
+                }
+            }
+
+            if (lastChunkUpdate != currChunkUpdate || lastTrackedChunk != chunk) {
+                // need to purge any players possibly not in the chunk list
+                for (final ServerPlayerConnection conn : this.seenBy()) {
+                    final ServerPlayer player = conn.getPlayer();
+                    if (!players.contains(player) && (toRemove == null || !toRemove.contains(player))) {
+                        if (toRemove == null) toRemove = new java.util.ArrayList<>(4);
+                        toRemove.add(player);
+                    }
+                }
+            }
+
+            return toAdd == null && toRemove == null
+                ? null
+                : new org.bxteam.divinemc.async.tracking.ParallelEntityTracker.ScanResult(this, toAdd, toRemove, false);
+        }
+
+        public final void applyScan(final org.bxteam.divinemc.async.tracking.ParallelEntityTracker.ScanResult result) {
+            if (result.clearAll()) {
+                this.moonrise$clearPlayers();
+                return;
+            }
+
+            final java.util.List<ServerPlayer> toRemove = result.toRemove();
+            if (toRemove != null) {
+                for (int i = 0, len = toRemove.size(); i < len; ++i) {
+                    this.removePlayer(toRemove.get(i));
+                }
+            }
+
+            final java.util.List<ServerPlayer> toAdd = result.toAdd();
+            if (toAdd != null) {
+                boolean added = false;
+                for (int i = 0, len = toAdd.size(); i < len; ++i) {
+                    added |= this.addPlayer(toAdd.get(i));
+                }
+                if (added) {
+                    this.seenByUpdated();
+                }
+            }
+        }
+        // DivineMC end - Parallel entity tracker
