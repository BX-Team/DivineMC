@@ -86,6 +93,11 @@ public record EndIslandFunction() implements DensityFunction {
 
         @Override
         public float sampleValue(final SamplerContext context, final int blockX, final int blockY, final int blockZ) {
+            // DivineMC start - C2ME: native math optimization
