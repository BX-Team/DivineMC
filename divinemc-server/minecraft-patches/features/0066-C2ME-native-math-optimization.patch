diff --git a/net/minecraft/server/Main.java b/net/minecraft/server/Main.java
index e788312524ad186722c4b133f476499ca1c14bde..1cbb1fa882aae0ab8c3a51dd4e1219acd2068dad 100644
--- a/net/minecraft/server/Main.java
+++ b/net/minecraft/server/Main.java
@@ -112,6 +112,26 @@ public class Main {
             org.purpurmc.purpur.PurpurConfig.registerMinecraftDisabledCommands = purpurConfiguration.getBoolean("settings.register-minecraft-disabled-commands"); // Purpur - register disabled minecraft commands
             // Purpur end - Add toggle for enchant level clamping - load config files early
 
+            // DivineMC start - C2ME: native math optimization
+            org.bukkit.configuration.file.YamlConfiguration divinemcConfiguration = io.papermc.paper.configuration.PaperConfigurations.loadLegacyConfigFile((File) options.valueOf("divinemc-settings"));
+            boolean divinemcNativeMathEnabled = divinemcConfiguration.getBoolean("performance.chunks.native-acceleration.enabled", false);
+            if (divinemcNativeMathEnabled) {
+                org.bxteam.divinemc.config.DivineConfig.PerformanceCategory.allowAVX512 =
+                    divinemcConfiguration.getBoolean("performance.chunks.native-acceleration.allow-avx512", false);
+                int divinemcIsaTargetLevelOverride =
+                    divinemcConfiguration.getInt("performance.chunks.native-acceleration.isa-target-level-override", -1);
+                if (divinemcIsaTargetLevelOverride < -1 || divinemcIsaTargetLevelOverride > 13) {
+                    divinemcIsaTargetLevelOverride = -1;
+                }
+                org.bxteam.divinemc.config.DivineConfig.PerformanceCategory.isaTargetLevelOverride = divinemcIsaTargetLevelOverride;
+                try {
+                    Class.forName("org.bxteam.divinemc.math.NativeLoader").getField("lookup").get(null);
+                } catch (Throwable e) {
+                    LOGGER.error("Failed to initialize native math acceleration, continuing without it", e);
+                }
+            }
+            // DivineMC end - C2ME: native math optimization
+
             io.papermc.paper.plugin.PluginInitializerManager.load(options); // Paper
             Bootstrap.bootStrap();
             Bootstrap.validate();
diff --git a/net/minecraft/world/level/biome/BiomeManager.java b/net/minecraft/world/level/biome/BiomeManager.java
index 99b4cf3529c973c154277e07108fc6d2d0bead76..73ad063a380c54e0804455ae66dc03459d640337 100644
--- a/net/minecraft/world/level/biome/BiomeManager.java
+++ b/net/minecraft/world/level/biome/BiomeManager.java
@@ -37,6 +37,16 @@ public class BiomeManager {
     }
 
     public Holder<Biome> getBiome(final int blockX, final int blockY, final int blockZ) { // DivineMC - Carpet-Fixes: Optimized getBiome method - rename params
+        // DivineMC start - C2ME: native math optimization
+        if (org.bxteam.divinemc.config.DivineConfig.PerformanceCategory.nativeAccelerationEnabled) {
+            final int mask = org.bxteam.divinemc.math.Bindings.c2me_natives_biome_access_sample(this.biomeZoomSeed, blockX, blockY, blockZ);
+            return this.noiseBiomeSource.getNoiseBiome(
+                ((blockX - 2) >> 2) + ((mask & 4) != 0 ? 1 : 0),
+                ((blockY - 2) >> 2) + ((mask & 2) != 0 ? 1 : 0),
+                ((blockZ - 2) >> 2) + ((mask & 1) != 0 ? 1 : 0)
+            );
+        }
+        // DivineMC end - C2ME: native math optimization
         // DivineMC start - Carpet-Fixes: Optimized getBiome method
         int xMinus2 = blockX - 2;
         int yMinus2 = blockY - 2;
