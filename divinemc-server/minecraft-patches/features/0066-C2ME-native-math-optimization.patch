diff --git a/net/minecraft/world/level/levelgen/synth/NoiseStack.java b/net/minecraft/world/level/levelgen/synth/NoiseStack.java
index 3cb7094148b00eba7c46c3ec56653c02d179c6bb..e63aa4e9a964a9c2bb5e5b1551052ee37c55f8e3 100644
--- a/net/minecraft/world/level/levelgen/synth/NoiseStack.java
+++ b/net/minecraft/world/level/levelgen/synth/NoiseStack.java
@@ -76,12 +76,23 @@ public class NoiseStack implements Noise {
         }
 
         public NoiseStack.Builder add(final Noise noise, final double frequency, final float amplitude) {
+            // DivineMC start - C2ME: native math optimization - flatten nested stacks so the specialized Perlin stacks can be used
+            if (noise instanceof NoiseStack nested && org.bxteam.divinemc.config.DivineConfig.PerformanceCategory.nativeAccelerationEnabled) {
+                return this.addStack(nested, frequency, amplitude);
+            }
+            // DivineMC end - C2ME: native math optimization - flatten nested stacks so the specialized Perlin stacks can be used
             this.layers.add(new NoiseStack.Layer(noise, frequency, amplitude));
             return this;
         }
 
         public NoiseStack.Builder addStack(final NoiseStack stack, final double frequency, final float amplitude) {
             for (NoiseStack.Layer layer : stack.layers) {
+                // DivineMC start - C2ME: native math optimization - flatten nested stacks so the specialized Perlin stacks can be used
+                if (org.bxteam.divinemc.config.DivineConfig.PerformanceCategory.nativeAccelerationEnabled) {
+                    this.add(layer.noise, layer.frequency * frequency, layer.amplitude * amplitude);
+                    continue;
+                }
+                // DivineMC end - C2ME: native math optimization - flatten nested stacks so the specialized Perlin stacks can be used
                 this.layers.add(new NoiseStack.Layer(layer.noise, layer.frequency * frequency, layer.amplitude * amplitude));
             }
 
