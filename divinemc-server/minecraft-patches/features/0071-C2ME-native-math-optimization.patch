         default void fillArray(final double[] output, final DensityFunction.ContextProvider contextProvider) {
             contextProvider.fillAllDirectly(output, this);
         }
+
+        // DivineMC start - C2ME: native math optimization
+        default boolean divinemc$fillArrayNative(final double[] output, final DensityFunction.ContextProvider contextProvider, final int axisMode) {
+            final NormalNoise normalNoise = this.offsetNoise().noise();
+            final long ptr = normalNoise == null ? 0L : normalNoise.divinemc$nativePointer();
+            if (ptr == 0L) {
+                return false;
+            }
+            final int length = output.length;
+            final double[] x = new double[length];
+            final double[] y = new double[length];
+            final double[] z = new double[length];
+            for (int i = 0; i < length; i++) {
+                final DensityFunction.FunctionContext context = contextProvider.forIndex(i);
+                switch (axisMode) {
+                    case 1 -> {
+                        x[i] = context.blockX() * 0.25;
+                        y[i] = 0.0;
+                        z[i] = context.blockZ() * 0.25;
+                    }
+                    case 2 -> {
+                        x[i] = context.blockZ() * 0.25;
+                        y[i] = context.blockX() * 0.25;
+                        z[i] = 0.0;
+                    }
+                    default -> {
+                        x[i] = context.blockX() * 0.25;
+                        y[i] = context.blockY() * 0.25;
+                        z[i] = context.blockZ() * 0.25;
+                    }
+                }
+            }
+            org.bxteam.divinemc.math.Bindings.c2me_natives_noise_perlin_double_batch(
+                ptr,
+                java.lang.foreign.MemorySegment.ofArray(output),
+                java.lang.foreign.MemorySegment.ofArray(x),
+                java.lang.foreign.MemorySegment.ofArray(y),
+                java.lang.foreign.MemorySegment.ofArray(z),
+                length);
+            for (int i = 0; i < length; i++) {
+                output[i] *= 4.0;
+            }
+            return true;
+        }
+        // DivineMC end - C2ME: native math optimization
     }
 
