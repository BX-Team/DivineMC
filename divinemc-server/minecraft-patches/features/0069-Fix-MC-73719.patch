From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NONPLAYT <nonplay@bxteam.org>
Date: Thu, 24 Sep 2026 03:37:35 +0300
Subject: [PATCH] Fix MC-73719


diff --git a/net/minecraft/server/level/ServerEntity.java b/net/minecraft/server/level/ServerEntity.java
index 432dd83733d871c94a644ff3405c5970a607b125..52d424f9aa1a5f09cd9427423b9fa1fabf69f542 100644
--- a/net/minecraft/server/level/ServerEntity.java
+++ b/net/minecraft/server/level/ServerEntity.java
@@ -176,6 +176,25 @@ public class ServerEntity {
                 PositionPath position = this.interpolationTracker.getPositionPath(currentPosition);
                 this.interpolationTracker.clear();
                 MovementPacket<ClientGamePacketListener> packet;
+                // DivineMC start - Fix MC-73719
+                if (org.bxteam.divinemc.config.DivineConfig.FixesCategory.fixMc73719
+                    && this.entity instanceof net.minecraft.world.entity.boss.enderdragon.EnderDragon dragon
+                    && dragon.isNoAi()) {
+                    packet = null;
+                    Vec3 base = this.positionCodec.base;
+                    double dx = currentPosition.x - base.x;
+                    double dy = currentPosition.y - base.y;
+                    double dz = currentPosition.z - base.z;
+                    boolean positionChanged = (dx * dx + dy * dy + dz * dz) >= 7.62939453125E-6D;
+                    if (positionChanged || shouldSendRotation || this.forceStateResync || this.teleportDelay > 400) {
+                        this.teleportDelay = 0;
+                        this.synchronizer.sendToTrackingPlayers(this.snapNoAiDragon(base));
+                        this.positionCodec.setBase(currentPosition);
+                        this.lastSentYRot = yRotn;
+                        this.lastSentXRot = xRotn;
+                    }
+                } else
+                // DivineMC end - Fix MC-73719
                 if (this.entity instanceof AbstractArrow) {
                     packet = this.createMovePacket(position, yRotn, xRotn, true, true);
                 } else {
@@ -413,6 +432,21 @@ public class ServerEntity {
         }
     }
 
+    // DivineMC start - Fix MC-73719
+    private Packet<ClientGamePacketListener> snapNoAiDragon(final Vec3 lastSent) {
+        Vec3 target = this.entity.trackingPosition();
+        float yRot = this.entity.getYRot();
+        float xRot = this.entity.getXRot();
+        Vec3 detour = target.add(0.0, lastSent.y > target.y ? -128.0 : 128.0, 0.0);
+        return new ClientboundBundlePacket(
+            List.of(
+                new ClientboundEntityPositionSyncPacket(this.entity.getId(), PositionPath.of(detour), yRot, xRot, this.entity.onGround()),
+                ClientboundEntityPositionSyncPacket.of(this.entity)
+            )
+        );
+    }
+    // DivineMC end - Fix MC-73719
+
     public Vec3 getPositionBase() {
         return this.positionCodec.getBase();
     }
diff --git a/net/minecraft/world/entity/boss/enderdragon/EnderDragon.java b/net/minecraft/world/entity/boss/enderdragon/EnderDragon.java
index e75c6494da7c0dd96bcb6cf51a467ee511a3bf21..1d2bd948ce647515dbb35acafaa04b1284fbee2b 100644
--- a/net/minecraft/world/entity/boss/enderdragon/EnderDragon.java
+++ b/net/minecraft/world/entity/boss/enderdragon/EnderDragon.java
@@ -308,6 +308,11 @@ public class EnderDragon extends Mob implements Enemy {
             this.setYRot(Mth.wrapDegrees(this.getYRot()));
             if (this.isNoAi()) {
                 this.flapTime = 0.5F;
+                // DivineMC start - Fix MC-73719
+                if (org.bxteam.divinemc.config.DivineConfig.FixesCategory.fixMc73719 && !this.level().isClientSide()) {
+                    this.positionPartsWithoutAi();
+                }
+                // DivineMC end - Fix MC-73719
             } else {
                 this.flightHistory.record(this.getY(), this.getYRot());
                 if (this.level() instanceof ServerLevel level && !hasRider) { // Purpur - Ridables
@@ -448,6 +453,36 @@ public class EnderDragon extends Mob implements Enemy {
         }
     }
 
+    // DivineMC start - Fix MC-73719
+    private void positionPartsWithoutAi() {
+        float tilt = (float)(this.flightHistory.get(5).y() - this.flightHistory.get(10).y()) * 10.0F * Mth.DEG_TO_RAD;
+        float ccTilt = Mth.cos(tilt);
+        float ssTilt = Mth.sin(tilt);
+        float rot1 = this.getYRot() * Mth.DEG_TO_RAD;
+        float ss1 = Mth.sin(rot1);
+        float cc1 = Mth.cos(rot1);
+        this.tickPart(this.body, ss1 * 0.5F, 0.0, -cc1 * 0.5F);
+        this.tickPart(this.wing1, cc1 * 4.5F, 2.0, ss1 * 4.5F);
+        this.tickPart(this.wing2, cc1 * -4.5F, 2.0, ss1 * -4.5F);
+        float ss2 = Mth.sin(this.getYRot() * Mth.DEG_TO_RAD - this.yRotA * 0.01F);
+        float cc2 = Mth.cos(this.getYRot() * Mth.DEG_TO_RAD - this.yRotA * 0.01F);
+        float yOffset = this.getHeadYOffset();
+        this.tickPart(this.head, ss2 * 6.5F * ccTilt, yOffset + ssTilt * 6.5F, -cc2 * 6.5F * ccTilt);
+        this.tickPart(this.neck, ss2 * 5.5F * ccTilt, yOffset + ssTilt * 5.5F, -cc2 * 5.5F * ccTilt);
+        DragonFlightHistory.Sample p1 = this.flightHistory.get(5);
+        EnderDragonPart[] tails = {this.tail1, this.tail2, this.tail3};
+
+        for (int i = 0; i < tails.length; i++) {
+            DragonFlightHistory.Sample p0 = this.flightHistory.get(12 + i * 2);
+            float rot = this.getYRot() * Mth.DEG_TO_RAD + this.rotWrap(p0.yRot() - p1.yRot()) * Mth.DEG_TO_RAD;
+            float ss = Mth.sin(rot);
+            float cc = Mth.cos(rot);
+            float dd = (i + 1) * 2.0F;
+            this.tickPart(tails[i], -(ss1 * 1.5F + ss * dd) * ccTilt, p0.y() - p1.y() - (dd + 1.5F) * ssTilt + 1.5, (cc1 * 1.5F + cc * dd) * ccTilt);
+        }
+    }
+    // DivineMC end - Fix MC-73719
+
     private void tickPart(final EnderDragonPart part, final double x, final double y, final double z) {
         part.setPos(this.getX() + x, this.getY() + y, this.getZ() + z);
     }
