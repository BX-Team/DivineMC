@@ -32,10 +32,12 @@ public class Activity {
     public static final Activity DIG = register("dig");
     private final String name;
     private final int hashCode;
+    public final int id; // DivineMC - Brain activity bitsets
 
-    private Activity(final String name) {
+    private Activity(final String name, final int id) {
         this.name = name;
         this.hashCode = name.hashCode();
+        this.id = id; // DivineMC - Brain activity bitsets
     }
 
     public String getName() {
@@ -43,7 +45,7 @@ public class Activity {
     }
 
     private static Activity register(final String name) {
-        return Registry.register(BuiltInRegistries.ACTIVITY, name, new Activity(name));
+        return Registry.register(BuiltInRegistries.ACTIVITY, name, new Activity(name, BuiltInRegistries.ACTIVITY.size())); // DivineMC - Brain activity bitsets
     }
 
